[Unit]
Description=Headless Fldigi decoder for RF MCP
After=sound.target

[Service]
Type=simple
User=__RF_MCP_USER__
Group=__RF_MCP_USER__
Environment=HOME=__RF_MCP_HOME__
Environment=ALSA_CONFIG_PATH=__RF_MCP_HOME__/SDR-MCP/config/fldigi-asound.conf
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1024x768x24" /usr/bin/fldigi --config-dir=__RF_MCP_HOME__/SDR-MCP-data/fldigi-config --xmlrpc-server-address=127.0.0.1 --xmlrpc-server-port=7362 --xmlrpc-allow=^(fldigi[.](version|list)|main[.](rx_only|rx|set_wf_sideband|set_squelch)|modem[.](get_names|get_name|get_quality|set_by_name|set_carrier)|text[.](clear_rx|get_rx|get_rx_length)|rx[.]get_data)$
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__RF_MCP_HOME__/SDR-MCP-data

[Install]
WantedBy=multi-user.target
