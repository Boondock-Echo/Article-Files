[Unit]
Description=Multi-SDR RF Lab MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RF_MCP_USER__
Group=__RF_MCP_USER__
WorkingDirectory=__RF_MCP_HOME__/SDR-MCP
Environment=RF_MCP_HOST=0.0.0.0
Environment=RF_MCP_PORT=8765
Environment=RF_MCP_TRANSPORT=streamable-http
Environment=RF_MCP_DATA_DIR=__RF_MCP_HOME__/SDR-MCP-data
Environment=MPLCONFIGDIR=__RF_MCP_HOME__/SDR-MCP-data/matplotlib-cache
EnvironmentFile=-/etc/SDR-MCP.env
ExecStart=__RF_MCP_HOME__/SDR-MCP/.venv/bin/SDR-MCP
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=__RF_MCP_HOME__/SDR-MCP-data

[Install]
WantedBy=multi-user.target
